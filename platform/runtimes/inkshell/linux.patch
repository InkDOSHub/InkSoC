+            let ok = match cmp { 0 => old == carg, 1 => old != carg, 2 => (old as i32) < carg as i32, 3 => (old as i32) <= carg as i32, 4 => (old as i32) > carg as i32, _ => (old as i32) >= carg as i32 };
