+        0x5410 => { let g = e.r32(a); if let Some(t) = lx(e).ptys.get_mut(&id) { t.fg = g; } 0 } // TIOCSPGRP
+        0x540E => { if let Some(p) = lx(e).procs.get_mut(&me) { p.ctty = id + 1; } 0 } // TIOCSCTTY
